<!DOCTYPE html>
<html>
<head>
  <!--
    If you are serving your web app in a path other than the root, change the
    href value below to reflect the base path you are serving from.

    The path provided below has to start and end with a slash "/" in order for
    it to work correctly.

    For more details:
    * https://developer.mozilla.org/en-US/docs/Web/HTML/Element/base

    This is a placeholder for base href that will be replaced by the value of
    the `--base-href` argument provided to `flutter build`.
  -->
  <base href="/">

  <meta charset="UTF-8">
  <meta content="IE=Edge" http-equiv="X-UA-Compatible">
  <meta name="description" content="국가공인 1급 컴퓨터 정비사가 추천하는 조립컴퓨터를 우리동네에서!">

  <meta property="og:title" content="우주딜러" />
  <meta property="og:type" content="website" />
  <meta property="og:image" content="https://firebasestorage.googleapis.com/v0/b/woojudealer-402eb.appspot.com/o/wooju_og_black.png?alt=media&token=d1a7f291-abe4-418c-ade6-b03a831ec4af" />
  <meta property="og:url" content="https://woojudealer.com/#/landing" />
  <meta property="og:description" content="국가공인 1급 컴퓨터 정비사가 추천하는 조립컴퓨터를 우리동네에서!" />

  <!-- iOS meta tags & icons -->
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black">
  <meta name="apple-mobile-web-app-title" content="우주딜러">
  <link rel="apple-touch-icon" href="logo.png">

  <!-- Favicon -->
  <link rel="icon" type="image/png" href="logo.png"/>

  <title>우주딜러</title>
  <link rel="manifest" href="manifest.json">
  
  <script>
    // 버전 관리를 위한 스크립트
    window.appVersion = '${Date.now()}';
  </script>
  
  <!-- 폰트 프리로드 최적화 - 필수 폰트만 프리로드 -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  
  <!-- 한글 서브셋 폰트만 프리로드 (Regular, Bold만) -->
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;700&display=swap&subset=korean" onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;700&display=swap&subset=korean"></noscript>
  
  <!-- Critical CSS 인라인 -->
  <style>
    /* 폰트 페이스 직접 정의 - 웹폰트 로드 전 대체 */
    @font-face {
      font-family: 'Noto Sans KR';
      font-style: normal;
      font-weight: 400;
      font-display: swap;
      src: local('Noto Sans KR Regular'), local('NotoSansKR-Regular');
    }
    
    @font-face {
      font-family: 'Noto Sans KR';
      font-style: normal;
      font-weight: 700;
      font-display: swap;
      src: local('Noto Sans KR Bold'), local('NotoSansKR-Bold');
    }
    
    /* 로딩 화면 스타일 */
    .loading-container {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background-color: #000;
      display: flex;
      justify-content: center;
      align-items: center;
      z-index: 999999;
      transition: opacity 0.2s ease-out;
    }
    
    .loading-gif {
      width: 240px;
      height: 240px;
      max-width: 80vw;
      max-height: 80vh;
    }
    
    .fade-out {
      opacity: 0;
      pointer-events: none;
    }
    
    /* 초기 렌더링 최적화 */
    body {
      margin: 0;
      padding: 0;
      overflow: hidden;
      background-color: #000;
    }
    
    /* 폰트 로드 중 텍스트 숨김 방지 */
    .font-loading {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }
  </style>
</head>
<body>
  <!-- 로딩 화면 -->
  <div id="loading-screen" class="loading-container">
    <img src="assets/assets/Landing/WooJu_Landing240x240_x3.gif" alt="Loading..." class="loading-gif">
  </div>
  
  <!-- reCAPTCHA container for Firebase Auth -->
  <div id="recaptcha-container"></div>
  
  <script>
    // 즉시 실행되는 최적화 스크립트
    (function() {
      // 로딩 GIF 프리로드
      var img = new Image();
      img.src = 'assets/assets/Landing/WooJu_Landing240x240_x3.gif';
      
      // Flutter 로드 완료 시 로딩 화면 제거
      var loadingScreen = document.getElementById('loading-screen');
      var isFlutterReady = false;
      
      // Flutter 준비 완료 처리
      function hideLoading() {
        if (isFlutterReady && loadingScreen) {
          loadingScreen.classList.add('fade-out');
          setTimeout(function() {
            if (loadingScreen && loadingScreen.parentNode) {
              loadingScreen.parentNode.removeChild(loadingScreen);
            }
            document.body.style.overflow = 'auto';
          }, 200);
        }
      }
      
      // Flutter first frame 이벤트
      window.addEventListener('flutter-first-frame', function() {
        isFlutterReady = true;
        hideLoading();
      });
      
      // 최대 대기 시간 설정 (3초)
      setTimeout(function() {
        isFlutterReady = true;
        hideLoading();
      }, 3000);
      
      // 폰트 로드 최적화
      if ('fonts' in document) {
        Promise.all([
          document.fonts.load('400 1em Noto Sans KR'),
          document.fonts.load('700 1em Noto Sans KR')
        ]).then(function() {
          document.body.classList.add('fonts-loaded');
        });
      }
    })();
  </script>
  
  <!-- Firebase SDK - Flutter와 별도로 웹용 Firebase 초기화 -->
  <script src="https://www.gstatic.com/firebasejs/10.7.0/firebase-app-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/10.7.0/firebase-auth-compat.js"></script>
  
  <script>
    // 웹용 Firebase 초기화 (Flutter와 별도)
    const firebaseConfig = {
      apiKey: "AIzaSyB2IxunswIltbM4fSSOeoHyVGvu8c9IzpE",
      authDomain: "woojudealer-402eb.firebaseapp.com",
      projectId: "woojudealer-402eb",
      storageBucket: "woojudealer-402eb.appspot.com",
      messagingSenderId: "400738015812",
      appId: "1:400738015812:web:0baaebc3ee89a9e6d4ba11",
      measurementId: "G-D1FREPD0D0"
    };
    
    // 이미 초기화되어 있지 않은 경우에만 초기화
    if (!firebase.apps.length) {
      firebase.initializeApp(firebaseConfig);
    }
    
    // reCAPTCHA 설정 함수 - 개선된 버전
    window.setupRecaptchaVerifier = function() {
      // 기존 verifier가 있으면 clear
      if (window.recaptchaVerifier) {
        window.recaptchaVerifier.clear();
        window.recaptchaVerifier = null;
      }
      
      try {
        window.recaptchaVerifier = new firebase.auth.RecaptchaVerifier('recaptcha-container', {
          'size': 'invisible',
          'callback': (response) => {
            console.log('reCAPTCHA verified successfully');
          },
          'expired-callback': () => {
            console.log('reCAPTCHA expired - resetting');
            // reCAPTCHA 만료 시 재설정
            if (window.recaptchaVerifier) {
              window.recaptchaVerifier.clear();
              window.recaptchaVerifier = null;
            }
          }
        });
        
        // render를 나중에 호출하도록 변경
        console.log('reCAPTCHA verifier created');
      } catch (error) {
        console.error('Error creating reCAPTCHA verifier:', error);
      }
      
      return window.recaptchaVerifier;
    };
    
    // reCAPTCHA 렌더링 함수
    window.renderRecaptcha = function() {
      if (window.recaptchaVerifier && !window.recaptchaWidgetId) {
        return window.recaptchaVerifier.render().then((widgetId) => {
          window.recaptchaWidgetId = widgetId;
          console.log('reCAPTCHA rendered with widget ID:', widgetId);
          return widgetId;
        }).catch((error) => {
          console.error('reCAPTCHA render error:', error);
          throw error;
        });
      }
      return Promise.resolve(window.recaptchaWidgetId);
    };
  </script>
  
  <!-- Flutter 부트스트랩 - defer로 변경하여 파싱 차단 방지 -->
  <script src="flutter_bootstrap.js" defer></script>
</body>
</html>

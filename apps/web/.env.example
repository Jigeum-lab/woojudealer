# 우주딜러 web 환경변수 예시 — 복사해서 .env.local 로 만들고 값을 채운다.
# 값은 Supabase 프로젝트 → Settings → API 에서 복사.

# Project URL (https://xxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# anon / public key (공개키)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role key (secret) — 필수.
# 공개 QR 인증 페이지(/c/[qr_token])가 RLS 우회 조회에 사용한다.
SUPABASE_SERVICE_ROLE_KEY=

# 앱 기본 URL (로컬: http://localhost:3400, 배포: https://woojudealer.vercel.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3400

# Google 로그인 버튼 노출 여부.
# Supabase → Authentication → Providers 에서 Google을 켜고 OAuth 키를 등록한
# 뒤에 1로 바꾼다. 그 전에 켜면 버튼이 눌려도 실패한다.
NEXT_PUBLIC_GOOGLE_LOGIN=0
